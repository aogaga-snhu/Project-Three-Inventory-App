<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="28dp" android:gravity="center" android:background="@color/light">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inventory SMS Alerts" android:textStyle="bold" android:textSize="24sp" android:textColor="@color/navy"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Allow Inventory App to send SMS notifications when an item's quantity reaches zero?" android:textSize="16sp" android:textColor="@color/text" android:layout_marginTop="14dp"/>
<TextView android:id="@+id/textPermissionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SMS permission has not been selected." android:textStyle="bold" android:textColor="@color/muted" android:layout_marginTop="18dp"/>
<EditText android:id="@+id/editAlertPhone" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Recipient phone number" android:inputType="phone"/><Button android:id="@+id/buttonSavePhone" android:layout_width="match_parent" android:layout_height="52dp" android:text="SAVE PHONE NUMBER"/><Button android:id="@+id/buttonAllowSms" android:layout_width="match_parent" android:layout_height="52dp" android:text="ALLOW SMS ALERTS" android:textColor="@color/white" android:background="@drawable/button_primary" android:layout_marginTop="20dp"/>
<Button android:id="@+id/buttonDeclineSms" android:layout_width="match_parent" android:layout_height="52dp" android:text="NO THANKS" android:layout_marginTop="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="You can continue using inventory features if you decline. Only SMS zero-stock alerts will be unavailable." android:textSize="13sp" android:textColor="@color/muted" android:layout_marginTop="14dp"/>
<Button android:id="@+id/buttonContinueInventory" android:layout_width="match_parent" android:layout_height="52dp" android:text="CONTINUE TO INVENTORY" android:layout_marginTop="20dp"/>
</LinearLayout></LinearLayout>
